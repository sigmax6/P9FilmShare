<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- 尽力自动开热点需要；普通 App 需在系统设置里手动授予（ACTION_MANAGE_WRITE_SETTINGS） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- 仅老系统(P9/Android6)需要; 卓易通 Android16 走分区存储, 用 maxSdkVersion 限定 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 扫码（可选路径）；局域网自动发现只用普通 Socket，不需要定位/附近设备权限 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:allowBackup="true"
        android:label="P9FilmShare"
        android:theme="@android:style/Theme.Material.Light"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".SenderActivity" android:exported="false"/>
        <activity android:name=".ReceiverActivity" android:exported="false"/>
        <activity android:name=".PickerActivity" android:exported="false"/>
        <activity android:name=".ScanActivity" android:exported="false"/>

        <service
            android:name=".ShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
